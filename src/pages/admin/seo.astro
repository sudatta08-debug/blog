---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { seoChecks, seoScore, formatDate, wordCount } from '../../lib/posts';

// Include drafts so you can fix them before publishing.
const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const rows = posts.map((p) => {
  const checks = seoChecks(p, posts);
  return { p, checks, score: seoScore(checks), words: wordCount(p.body) };
});
rows.sort((a, b) => a.score - b.score);
const avg = rows.length ? Math.round(rows.reduce((s, r) => s + r.score, 0) / rows.length) : 0;
const noKeyword = rows.filter((r) => !r.p.data.seo?.focusKeyword).length;
const noDesc = rows.filter((r) => !(r.p.data.seo?.description || r.p.data.description)).length;
const grade = (s: number) => (s >= 80 ? 'good' : s >= 55 ? 'ok' : 'poor');
---

<Base title="SEO report" noindex>
  <style>
    .seo-summary { display: flex; flex-wrap: wrap; gap: 2.5rem; font-family: var(--sans); margin: 0 0 2.5rem; }
    .seo-summary div { min-width: 8rem; }
    .seo-summary b { display: block; font-size: 2.4rem; letter-spacing: -0.03em; line-height: 1; }
    .seo-summary span { color: var(--slate); font-size: 0.95rem; }
    .seo-post { border-top: 1px solid var(--rule); padding: 1.1rem 0; }
    .seo-post summary { display: grid; grid-template-columns: 3.6rem 1fr auto; gap: 1rem; align-items: center; cursor: pointer; list-style: none; }
    .seo-post summary::-webkit-details-marker { display: none; }
    .score { font-family: var(--sans); font-weight: 800; font-size: 1.15rem; text-align: center; border-radius: 6px; padding: 0.4rem 0; }
    .score.good { background: #dcefe0; color: #1f5a2c; }
    .score.ok { background: var(--marigold-soft); color: #6b4a00; }
    .score.poor { background: #f6dcd8; color: #7a2418; }
    .seo-post h2 { font-size: 1.1rem; }
    .seo-post .meta { margin-top: 0.2rem; }
    .seo-post .act { font-family: var(--sans); font-size: 0.9rem; }
    .checks { list-style: none; padding: 0; margin: 1rem 0 0 4.6rem; font-family: var(--sans); font-size: 0.95rem; }
    .checks li { display: grid; grid-template-columns: 1.4rem 13rem 1fr; gap: 0.6rem; padding: 0.35rem 0; border-bottom: 1px dashed var(--rule); }
    .checks .tip { color: var(--slate); }
    @media (max-width: 760px) {
      .checks { margin-left: 0; }
      .checks li { grid-template-columns: 1.4rem 1fr; }
      .checks .tip { grid-column: 2; }
      .seo-post summary { grid-template-columns: 3.2rem 1fr; }
      .seo-post .act { grid-column: 2; }
    }
  </style>
  <div class="wrap">
    <header class="page-head">
      <p class="crumbs"><a href="/admin/">Back to admin</a></p>
      <h1>SEO report</h1>
      <p>Every post checked against the basics Google looks for. Lowest scores come first, so start at the top. This page is hidden from search engines.</p>
    </header>

    <div class="seo-summary">
      <div><b>{rows.length}</b><span>posts checked</span></div>
      <div><b>{avg}</b><span>average score</span></div>
      <div><b>{noKeyword}</b><span>without a focus keyword</span></div>
      <div><b>{noDesc}</b><span>without a description</span></div>
    </div>

    {rows.length === 0 && <p class="empty">No posts yet.</p>}

    {
      rows.map(({ p, checks, score }) => (
        <details class="seo-post">
          <summary>
            <span class={`score ${grade(score)}`} aria-label={`Score ${score} out of 100`}>{score}</span>
            <div>
              <h2>{p.data.title}</h2>
              <div class="meta">
                <span>{formatDate(p.data.pubDate)}</span>
                {p.data.draft && <span>Draft</span>}
                <span>{checks.filter((c) => !c.ok).length} to improve</span>
              </div>
            </div>
            <span class="act">
              <a href={`/admin/#/collections/posts/entries/${p.id}`}>Edit</a>
              {!p.data.draft && <> &nbsp; <a href={`/blog/${p.id}/`}>View</a></>}
            </span>
          </summary>
          <ul class="checks">
            {checks.map((c) => (
              <li>
                <span aria-label={c.ok ? 'Pass' : c.warn ? 'Could be better' : 'Fix'}>{c.ok ? '✅' : c.warn ? '🟡' : '❌'}</span>
                <strong>{c.label}</strong>
                <span class="tip">{c.tip}</span>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
  </div>
</Base>
