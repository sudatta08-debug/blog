---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import settings from '../../data/settings.json';
import { getPosts, excerpt, formatDate, readingTime, related, slugify, wordCount } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

const { post, all } = Astro.props;
const d = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const more = related(post, all);
const site = Astro.site ?? new URL(settings.siteUrl);
const url = new URL(`/blog/${post.id}/`, site).href;
const desc = d.seo?.description || excerpt(post);
const image = d.seo?.ogImage || d.cover;
const shareText = encodeURIComponent(d.title);
const shareUrl = encodeURIComponent(url);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: desc,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate || d.pubDate).toISOString(),
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  url,
  image: image ? [new URL(image, site).href] : undefined,
  author: { '@type': 'Person', name: settings.authorName, url: new URL('/about/', site).href },
  publisher: { '@type': 'Person', name: settings.authorName },
  keywords: [d.seo?.focusKeyword, ...d.tags].filter(Boolean).join(', '),
  wordCount: wordCount(post.body),
  inLanguage: settings.language,
};
const crumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Writing', item: site.href },
    ...(d.tags[0]
      ? [{ '@type': 'ListItem', position: 2, name: d.tags[0], item: new URL(`/tags/${slugify(d.tags[0])}/`, site).href }]
      : []),
    { '@type': 'ListItem', position: d.tags[0] ? 3 : 2, name: d.title, item: url },
  ],
};
---

<Base
  title={d.seo?.title || d.title}
  description={desc}
  image={image}
  imageAlt={d.coverAlt}
  canonical={d.seo?.canonical}
  noindex={d.seo?.noindex || d.draft}
  type="article"
  published={d.pubDate}
  modified={d.updatedDate}
  tags={d.tags}
  jsonLd={[articleLd, crumbsLd]}
>
  <div class="progress" aria-hidden="true"></div>
  <article>
    <header class="article-head read">
      <p class="crumbs">
        <a href="/">Writing</a>
        {d.tags[0] && <> / <a href={`/tags/${slugify(d.tags[0])}/`}>{d.tags[0]}</a></>}
      </p>
      <h1>{d.title}</h1>
      {d.description && <p class="lede">{d.description}</p>}
      <div class="meta">
        <span>By {settings.authorName}</span>
        <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate)}</time>
        {d.updatedDate && <span>Updated <time datetime={d.updatedDate.toISOString()}>{formatDate(d.updatedDate)}</time></span>}
        <span>{readingTime(post.body)} min read</span>
      </div>
    </header>

    {
      d.cover && (
        <figure class="cover">
          <img src={d.cover} alt={d.coverAlt || ''} width="1600" height="900" fetchpriority="high" />
        </figure>
      )
    }

    <div class="read">
      {
        toc.length >= 3 && (
          <details class="toc" open>
            <summary>In this post</summary>
            <ol>
              {toc.map((h) => (
                <li class={`depth-${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )
      }

      <div class="prose">
        <Content />
      </div>

      <footer class="post-foot">
        {
          d.tags.length > 0 && (
            <ul class="tag-cloud post-tags" aria-label="Topics">
              {d.tags.map((t) => (
                <li>
                  <a href={`/tags/${slugify(t)}/`}>{t}</a>
                </li>
              ))}
            </ul>
          )
        }
        <div class="share">
          <span>Share</span>
          <a href={`https://wa.me/?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener">WhatsApp</a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank" rel="noopener">LinkedIn</a>
          <a href={`https://x.com/intent/post?text=${shareText}&url=${shareUrl}`} target="_blank" rel="noopener">X</a>
          <button type="button" data-copy={url}>Copy link</button>
        </div>

        <div class="author-box">
          <div>
            <strong>{settings.authorName}</strong>
            <p>{settings.authorBio} <a href="/about/">More about me</a></p>
          </div>
        </div>
      </footer>

      {
        more.length > 0 && (
          <aside class="related" aria-labelledby="related-h">
            <h2 id="related-h">Read next</h2>
            <ul>
              {more.map((p) => (
                <li>
                  <a href={`/blog/${p.id}/`}>{p.data.title}</a>
                  <div class="meta">
                    <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
                    <span>{readingTime(p.body)} min read</span>
                  </div>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </article>

  <script>
    const bar = document.querySelector<HTMLElement>('.progress');
    const art = document.querySelector('article');
    if (bar && art && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const update = () => {
        const r = art.getBoundingClientRect();
        const total = r.height - innerHeight;
        const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
        bar.style.transform = `scaleX(${p})`;
      };
      addEventListener('scroll', update, { passive: true });
      update();
    }
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
      b.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.copy!);
          b.textContent = 'Link copied';
        } catch {
          b.textContent = 'Copy failed';
        }
        setTimeout(() => (b.textContent = 'Copy link'), 2000);
      })
    );
  </script>
</Base>
