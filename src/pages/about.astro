---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import settings from '../data/settings.json';

const page = await getEntry('pages', 'about');
const { Content } = page ? await render(page) : { Content: null };
const site = Astro.site ?? new URL(settings.siteUrl);
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: settings.authorName,
    description: settings.authorBio,
    url: new URL('/about/', site).href,
    sameAs: [settings.social.linkedin, settings.social.instagram, settings.social.twitter && `https://x.com/${settings.social.twitter.replace(/^@/, '')}`].filter(Boolean),
  },
};
---

<Base title={page?.data.title || 'About'} description={page?.data.description || settings.authorBio} jsonLd={[personLd]}>
  <div class="read">
    <header class="page-head">
      <h1>{page?.data.title || 'About'}</h1>
    </header>
    <div class="prose">{Content ? <Content /> : <p>{settings.authorBio}</p>}</div>
  </div>
</Base>
