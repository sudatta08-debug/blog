---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import settings from '../../data/settings.json';
import { getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const featured = posts.find((p) => p.data.featured);
  const rest = posts.filter((p) => p !== featured);
  const per = settings.postsPerPage;
  const pages = Math.ceil(rest.length / per);
  return Array.from({ length: Math.max(0, pages - 1) }, (_, i) => {
    const n = i + 2;
    return { params: { page: String(n) }, props: { list: rest.slice((n - 1) * per, n * per), n, pages } };
  });
}

const { list, n, pages } = Astro.props;
const prev = n === 2 ? '/' : `/page/${n - 1}/`;
const next = n < pages ? `/page/${n + 1}/` : undefined;
---

<Base title={`Writing, page ${n}`} description={`Older posts from ${settings.siteTitle}, page ${n}.`} prev={prev} next={next}>
  <div class="wrap">
    <header class="page-head">
      <h1>Writing</h1>
      <p>Page {n} of {pages}</p>
    </header>
    <PostList posts={list} />
    <nav class="pager" aria-label="Pages">
      <a href={prev}>Newer posts</a>
      {next ? <a href={next}>Older posts</a> : <span />}
    </nav>
  </div>
</Base>
